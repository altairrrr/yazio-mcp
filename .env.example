# Option 1: Email + password (classic login)
YAZIO_USERNAME=your-yazio-email@example.com
YAZIO_PASSWORD=your-yazio-password

# Option 2: Token direct (Sign in with Apple accounts)
# Get these from web.yazio.com DevTools → Network tab → Authorization header
# YAZIO_ACCESS_TOKEN=eyJhbGciOi...
# YAZIO_REFRESH_TOKEN=def50200...
